# Backend resolution with LLM_PROVIDER=auto: ASU -> NVIDIA -> Hugging Face -> local Ollama -> mock
LLM_PROVIDER=auto
# LLM_MODEL=            # overrides the model for whichever provider is chosen

# ASU Research Computing (https://openai.rc.asu.edu) - OpenAI-compatible
API_KEY=                # or ASU_API_KEY
ASU_MODEL=gemma4-31b-it

# NVIDIA NIM (https://build.nvidia.com) - OpenAI-compatible
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Hugging Face Inference Providers router - OpenAI-compatible
HF_TOKEN=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Local Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest
